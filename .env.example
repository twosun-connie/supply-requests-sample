# .env.example 로 저장하고 커밋한다. 값은 넣지 않는다. 실제 값은 .env.local 에 넣는다(커밋하지 않는다).
# 값은 Supabase 대시보드 Settings › API Keys 에 있다. 개발 프로젝트의 값을 넣는다.
# 운영 프로젝트의 값은 Vercel 의 환경 변수(Production)에만 넣는다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# admin-api 확장을 켰을 때만 쓴다. sb_secret_ 으로 시작하는 키다. RLS 를 우회한다.
# NEXT_PUBLIC_ 을 붙이지 않는다. Vercel 에는 Sensitive 로 등록한다.
# SUPABASE_SECRET_KEY=
