{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run test/db",
    "check:app": "node scripts/check-app.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:extensions": "node scripts/check-extensions.mjs",
    "check:deps": "pnpm audit --prod --audit-level high && pnpm audit signatures",
    "check:env": "node scripts/check-env.mjs",
    "report:rules": "node scripts/report-rules.mjs",
    "report:scale": "node scripts/report-scale.mjs",
    "verify:quick": "pnpm run check:app && pnpm run check:migrations && pnpm run check:extensions && pnpm run check:docs && pnpm run typecheck && pnpm run lint && pnpm run test:db && pnpm run report:rules",
    "verify": "pnpm run check:app && pnpm run check:migrations && pnpm run check:extensions && pnpm run check:docs && pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build && pnpm run report:rules && pnpm run report:docs && pnpm run report:scale",
    "db:push": "node scripts/db-push.mjs",
    "db:types": "node scripts/db-types.mjs",
    "supabase": "supabase",
    "prepare": "husky",
    "check:docs": "node scripts/check-docs.mjs",
    "docs:new": "node scripts/new-doc.mjs",
    "report:docs": "node scripts/report-docs.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "supabase": "^2.118.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "24.x"
  }
}
